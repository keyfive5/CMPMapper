{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CMP Mapper Custom Rules Schema",
  "description": "Custom Consent O Matic rules generated by CMP Mapper",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference URL"
    },
    "site_name": {
      "type": "object",
      "description": "Rule for a specific website",
      "properties": {
        "detectors": {
          "type": "object",
          "properties": {
            "presentMatcher": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "css"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "showingMatcher": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "css"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "methods": {
          "type": "object",
          "patternProperties": {
            "^(HIDE_CMP|DO_CONSENT|DO_REJECT|OPEN_OPTIONS|SAVE_CONSENT)$": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "click",
                        "hide",
                        "wait"
                      ]
                    },
                    "target": {
                      "type": "object",
                      "properties": {
                        "selector": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}